   },
   {
    "name": "date",
    "label": {
     "en": "Preferred date",
     "id": "Tanggal pilihan"
    },
    "type": "date",
    "required": true
   },
   {
    "name": "guests",
    "label": {
     "en": "Number of guests",
     "id": "Jumlah tamu"
    },
    "type": "select",
    "required": false,
    "options": [
     "1",
