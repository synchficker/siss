[
 {
  "id": "inquiry",
  "title": {
   "en": "Admissions inquiry",
   "id": "Pertanyaan penerimaan"
  },
  "mode": "manual",
  "email": "admissions@cakrawala.sch.id",
  "endpoint": "",
  "submitLabel": {
   "en": "Send inquiry",
   "id": "Kirim pertanyaan"
  },
  "successMessage": {
   "en": "Thank you! Our admissions team will reply within two school days.",
   "id": "Terima kasih! Tim penerimaan kami akan membalas dalam dua hari sekolah."
  },
  "fields": [
   {
    "name": "name",
    "label": {
     "en": "Parent / guardian name",
     "id": "Nama orang tua / wali"
    },
    "type": "text",
    "required": true
   },
   {
    "name": "email",
    "label": {
     "en": "Email",
     "id": "Email"
    },
    "type": "email",
    "required": true
   },
   {
    "name": "phone",
    "label": {
     "en": "Phone",
     "id": "Telepon"
    },
    "type": "tel",
    "required": false
   },
   {
    "name": "childAge",
    "label": {
     "en": "Child's current age",
     "id": "Usia anak saat ini"
    },
    "type": "select",
    "required": true,
    "options": [
     "3–5",
     "6–10",
     "11–13",
     "14–17"
    ]
   },
   {
    "name": "entryYear",
    "label": {
     "en": "Intended entry year",
     "id": "Rencana tahun masuk"
    },
    "type": "select",
    "required": true,
    "options": [
     "2026–2027",
     "2027–2028",
     "2028–2029"
    ]
   },
   {
    "name": "message",
    "label": {
     "en": "Your question",
     "id": "Pertanyaan Anda"
    },
    "type": "textarea",
    "required": false
   },
   {
    "name": "consent",
    "label": {
     "en": "I agree to be contacted about my inquiry and understand the privacy policy.",
     "id": "Saya setuju dihubungi terkait pertanyaan saya dan memahami kebijakan privasi."
    },
    "type": "checkbox",
    "required": true
   }
  ]
 },
 {
  "id": "visit",
